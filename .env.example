# Variables d'entorn per a DESENVOLUPAMENT LOCAL.
# Copieu aquest fitxer a `.env` i ompliu-hi els valors. `.env` està ignorat pel git.
# En producció (Render) aquestes variables es configuren al dashboard, no aquí.

# GitHub OAuth (USR-01).
# Creeu una OAuth App a https://github.com/settings/developers
# Authorization callback URL (local): http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostgreSQL local (si no les poseu, s'usen aquests valors per defecte).
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
