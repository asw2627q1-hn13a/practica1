<% content_for :title, @parent ? "Reply" : "Add a comment" %>

<div class="reply-page">
  <% if @parent %>
    <h2>Reply</h2>
    <ul class="comment-list">
      <li class="comment">
        <div class="comment-meta">
          <%= @parent.user.username %>
          <%= time_ago_in_words(@parent.created_at) %> ago
        </div>
        <div class="comment-body"><%= simple_format(@parent.body) %></div>
      </li>
    </ul>
  <% else %>
    <h2>Add a comment</h2>
  <% end %>

  <%= form_with model: [ @submission, @comment ], class: "comment-form" do |f| %>
    <% if @comment.errors.any? %>
      <div class="form-errors">
        <% @comment.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>
    <%= f.hidden_field :parent_id %>
    <%= f.text_area :body, rows: 4, cols: 60, placeholder: @parent ? "Your reply" : "Add a comment" %>
    <br>
    <%= f.submit(@parent ? "reply" : "add comment") %>
  <% end %>

  <p><%= link_to "← back to submission", submission_path(@submission) %></p>
</div>
