<div id="<%= dom_id submission %>">
  <div>
    <strong>Title:</strong>
    <%= submission.title %>
  </div>

  <div>
    <strong>Url:</strong>
    <%= submission.url %>
  </div>

  <div>
    <strong>Text:</strong>
    <%= submission.text %>
  </div>

  <div>
    <strong>Submission type:</strong>
    <%= submission.submission_type %>
  </div>

  <div>
    <strong>Points:</strong>
    <%= submission.points %>
  </div>

  <div>
    <strong>User:</strong>
    <%= submission.user_id %>
  </div>

</div>
