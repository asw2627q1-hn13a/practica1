<% content_for :title, "Hidden" %>
<%# ACT-06 / USR-08: extra top-bar tab, next to "submit"; each submission has an unhide action. %>
<% content_for :nav_extra, link_to("hidden submissions", hidden_path, class: "current") %>

<ol class="submission-list">
  <%= render partial: "item", collection: @submissions, as: :submission %>
</ol>

<% if @submissions.empty? %>
  <p>No hidden submissions.</p>
<% end %>