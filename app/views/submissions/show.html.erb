<% content_for :title, @submission.title %>

<div class="submission-detail">
  <div class="submission-title">
    <%= link_to @submission.title, (@submission.url.presence || submission_path(@submission)) %>
    <% if @submission.domain %>
      <span class="domain">(<%= @submission.domain %>)</span>
    <% end %>
  </div>
  <div class="submission-meta">
    <%= pluralize(@submission.points, "point") %>
    by <%= @submission.user.username %>
    <%= time_ago_in_words(@submission.created_at) %> ago
    | <%= pluralize(@submission.comments_count, "comment") %>
  </div>
  <% if @submission.text.present? %>
    <div class="submission-text"><%= simple_format(@submission.text) %></div>
  <% end %>
</div>

<%# COM-01: add a comment (logged-in users only). %>
<% if current_user %>
  <%= form_with model: [ @submission, @comment ], class: "comment-form" do |f| %>
    <% if @comment.errors.any? %>
      <div class="form-errors">
        <% @comment.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>
    <%= f.text_area :body, rows: 4, cols: 60, placeholder: "Add a comment" %>
    <br>
    <%= f.submit "add comment" %>
  <% end %>
<% else %>
  <p class="login-hint"><%= link_to "Log in", login_path %> to add a comment.</p>
<% end %>

<ul class="comment-list">
  <% @comments.each do |comment| %>
    <li class="comment">
      <div class="comment-meta">
        <%= comment.user.username %>
        <%= time_ago_in_words(comment.created_at) %> ago
      </div>
      <div class="comment-body"><%= simple_format(comment.body) %></div>
    </li>
  <% end %>
</ul>
