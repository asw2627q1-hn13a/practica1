<%= form_with model: user, class: "submit-form" do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <% user.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :user %>
    <%= user.username %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.text_field :email %>
  </div>

  <div class="field">
    <%= form.label :about %>
    <%= form.text_area :about, rows: 5, cols: 60 %>
  </div>

  <%= form.submit "update" %>
<% end %>