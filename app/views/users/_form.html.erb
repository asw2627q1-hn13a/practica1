<%= form_with model: user, class: "submit-form" do |form| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <% user.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :banner %>
    <%= check_box_tag "remove_banner", "1", false %>
    <%= label_tag "remove_banner", "delete" %>
    OR
    <%= form.file_field :banner, accept: "image/png,image/jpeg,image/gif,image/webp" %>
  </div>

  <div class="field">
    <%= form.label :avatar %>
    <%= check_box_tag "remove_avatar", "1", false %>
    <%= label_tag "remove_avatar", "delete" %>
    OR
    <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/gif,image/webp" %>
  </div>

  <div class="field">
    <%= form.label :user %>
    <%= user.username %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.text_field :email %>
  </div>

  <div class="field">
    <%= form.label :about %>
    <%= form.text_area :about, rows: 5, cols: 60 %>
  </div>

  <%= form.submit "update" %>
<% end %>