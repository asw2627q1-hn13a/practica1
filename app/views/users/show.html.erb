<% content_for :title, "Profile: #{@user.username}" %>

<div class="profile">
  <% if @user.respond_to?(:banner) && @user.banner.attached? %>
    <%= image_tag @user.banner, class: "profile-banner", alt: "banner" %>
  <% else %>
    <div class="profile-banner profile-placeholder">no banner</div>
  <% end %>

  <% if @user.respond_to?(:avatar) && @user.avatar.attached? %>
    <%= image_tag @user.avatar, class: "profile-avatar", alt: "avatar" %>
  <% else %>
    <div class="profile-avatar profile-placeholder">no avatar</div>
  <% end %>

  <table>
    <tr><td>user:</td><td><%= @user.username %></td></tr>
    <tr><td>created:</td><td><%= @user.created_at.strftime("%Y-%m-%d") %></td></tr>
    <tr><td>about:</td><td><%= @user.about.to_s %></td></tr>
  </table>
</div>