<% content_for :title, "Profile: #{@user.username}" %>

<div class="profile">

  <div class="profile-header">
    <% if @user.banner.attached? %>
      <%= image_tag @user.banner, class: "profile-banner", alt: "banner" %>
    <% else %>
      <%= image_tag "default_banner.png", class: "profile-banner", alt: "banner" %>
    <% end %>

    <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar, class: "profile-avatar", alt: "avatar" %>
    <% else %>
      <%= image_tag "default_avatar.png", class: "profile-avatar", alt: "avatar" %>
    <% end %>
  </div>

  <table>
    <tr><td>user:</td><td><%= @user.username %></td></tr>
    <tr><td>created:</td><td><%= @user.created_at.strftime("%Y-%m-%d") %></td></tr>
    <tr><td>about:</td><td><%= @user.about.to_s %></td></tr>
  </table>

  <% if current_user == @user %>
    <p><%= link_to "edit profile", edit_user_path(@user) %></p>
  <% end %>
</div>